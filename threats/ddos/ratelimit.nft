#!/usr/sbin/nft -f
# per-client rate limit: drop connections from any ip that goes over the rate

add table inet ratelimit
delete table inet ratelimit
table inet ratelimit {
    set throttled {
        type ipv4_addr
        flags dynamic
        timeout 1m
    }
    chain input {
        type filter hook input priority filter; policy accept;
        tcp dport 80 ct state new \
            update @throttled { ip saddr limit rate over 10/second burst 5 packets } \
            drop
    }
}
